{
  "manifest_version": 3,
  "name": "タンタン",
  "version": "1.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "タンタン"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "toggle-marker": {
      "suggested_key": {
        "default": "Shift+Alt+M",
        "mac": "Command+MacCtrl+M"
      },
      "description": "起動/終了"
    },
    "save-highlights": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "単語を送信"
    }
  }
}